#!/usr/bin/env python3
"""Train an event-level neural network on the established 22 scalar inputs.

The feature resolver, physical normalization, threshold scan, Asimov
significance, and operating-point tables are shared with
``train_event_bdt_22_variables.py``.  This makes the neural-network and BDT
results directly comparable; only the classifier and its required
preprocessing differ.
"""

from __future__ import annotations

import argparse
import inspect
import json
import sys
import time
from pathlib import Path
from typing import Any

import joblib
import numpy as np
import pandas as pd
from sklearn.impute import SimpleImputer
from sklearn.inspection import permutation_importance
from sklearn.metrics import average_precision_score, roc_auc_score
from sklearn.neural_network import MLPClassifier
from sklearn.preprocessing import StandardScaler

try:
    import train_event_bdt_22_variables as common
except ImportError as exc:
    raise RuntimeError(
        "Place train_event_nn_22_variables.py beside "
        "train_event_bdt_22_variables.py in scripts/ML/."
    ) from exc


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
        description=__doc__,
    )
    parser.add_argument("--dataset-root", type=Path, required=True)
    parser.add_argument("--normalization-manifest", type=Path, required=True)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument(
        "--jet-features",
        nargs="+",
        default=common.DEFAULT_JET_FEATURES,
        help="The 10 base features used for both leading and subleading jets.",
    )
    parser.add_argument(
        "--event-features",
        nargs="+",
        default=common.DEFAULT_EVENT_FEATURES,
        help="The two scalar event features.",
    )
    parser.add_argument("--max-training-events-per-class", type=int, default=0)
    parser.add_argument("--max-validation-events-per-class", type=int, default=0)
    parser.add_argument(
        "--background-systematics",
        type=float,
        nargs="+",
        default=[0.0, 0.0001, 0.01, 0.05, 0.10],
    )
    parser.add_argument("--optimize-background-systematic", type=float, default=0.0001)
    parser.add_argument("--min-background-neff", type=float, default=100.0)
    parser.add_argument("--thresholds", type=int, default=2001)
    parser.add_argument("--random-state", type=int, default=42)

    parser.add_argument(
        "--hidden-layer-sizes",
        type=int,
        nargs="+",
        default=[128, 64, 32],
        help="Numbers of neurons in the hidden layers.",
    )
    parser.add_argument(
        "--activation",
        choices=["identity", "logistic", "tanh", "relu"],
        default="relu",
    )
    parser.add_argument("--alpha", type=float, default=1.0e-4, help="L2 penalty.")
    parser.add_argument("--batch-size", type=int, default=2048)
    parser.add_argument("--max-epochs", type=int, default=100)
    parser.add_argument("--initial-learning-rate", type=float, default=1.0e-3)
    parser.add_argument("--validation-fraction", type=float, default=0.10)
    parser.add_argument("--early-stopping-patience", type=int, default=10)
    parser.add_argument("--tol", type=float, default=1.0e-4)
    parser.add_argument(
        "--importance-events-per-class",
        type=int,
        default=25_000,
        help="Class cap for permutation importance; zero disables it.",
    )
    return parser.parse_args()


def fit_preprocessing(
    X_train: pd.DataFrame, training_weights: np.ndarray
) -> tuple[SimpleImputer, StandardScaler, np.ndarray]:
    """Median-impute and standardize the inputs for neural-network training."""
    imputer = SimpleImputer(strategy="median")
    X_imputed = imputer.fit_transform(X_train).astype(np.float32, copy=False)
    scaler = StandardScaler(copy=False)
    try:
        X_scaled = scaler.fit_transform(X_imputed, sample_weight=training_weights)
    except TypeError:
        # Compatibility with old scikit-learn versions.
        X_scaled = scaler.fit_transform(X_imputed)
    return imputer, scaler, np.asarray(X_scaled, dtype=np.float32)


def transform_features(
    X: pd.DataFrame, imputer: SimpleImputer, scaler: StandardScaler
) -> np.ndarray:
    X_imputed = imputer.transform(X).astype(np.float32, copy=False)
    return np.asarray(scaler.transform(X_imputed), dtype=np.float32)


def weighted_resample_for_legacy_sklearn(
    X: np.ndarray,
    y: np.ndarray,
    training_weights: np.ndarray,
    seed: int,
) -> tuple[np.ndarray, np.ndarray]:
    """Construct an equal-class weighted sample if MLP lacks sample_weight."""
    rng = np.random.default_rng(seed)
    per_class = min(np.count_nonzero(y == 0), np.count_nonzero(y == 1))
    chosen = []
    for label in (0, 1):
        indices = np.flatnonzero(y == label)
        probabilities = training_weights[indices].astype(float)
        probabilities /= probabilities.sum()
        chosen.append(
            rng.choice(indices, size=per_class, replace=len(indices) < per_class,
                       p=probabilities)
        )
    selected = np.concatenate(chosen)
    rng.shuffle(selected)
    return X[selected], y[selected]


def composition_table(
    y: np.ndarray,
    scores: np.ndarray,
    weights: np.ndarray,
    processes: np.ndarray,
    threshold: float,
) -> pd.DataFrame:
    selected = scores >= threshold
    rows = []
    for process in np.unique(processes):
        all_mask = processes == process
        mask = selected & all_mask
        sumw = weights[mask].sum()
        sumw2 = np.square(weights[mask]).sum()
        rows.append(
            {
                "process": process,
                "class": "signal" if y[all_mask][0] else "background",
                "yield": sumw,
                "efficiency": sumw / weights[all_mask].sum(),
                "neff": sumw * sumw / sumw2 if sumw2 > 0 else 0.0,
            }
        )
    return pd.DataFrame(rows)


def main() -> None:
    args = parse_args()
    if args.thresholds < 2:
        raise ValueError("--thresholds must be at least 2")
    if not args.hidden_layer_sizes or any(size <= 0 for size in args.hidden_layer_sizes):
        raise ValueError("--hidden-layer-sizes must contain positive integers")
    if args.optimize_background_systematic not in args.background_systematics:
        args.background_systematics.append(args.optimize_background_systematic)
    args.output_dir.mkdir(parents=True, exist_ok=True)

    manifest = json.loads(args.normalization_manifest.read_text())
    event_feature_names = list(args.event_features)
    jet_feature_names = list(args.jet_features)
    if len(event_feature_names) != 2 or len(jet_feature_names) != 10:
        raise RuntimeError(
            "Expected 2 event features and 10 per-jet features "
            f"(22 inputs total), found {len(event_feature_names)} and "
            f"{len(jet_feature_names)}."
        )

    first_pattern = str(manifest["samples"][0]["path_glob"])
    first_file = common.sample_files(args.dataset_root, first_pattern, "train")[0]
    sources = common.resolve_feature_sources(
        event_feature_names,
        jet_feature_names,
        common.parquet_columns(first_file),
        first_file,
    )
    output_names = [source.output_name for source in sources]
    print("Resolved 22 event inputs:")
    for source in sources:
        suffix = f"[{source.element}]" if source.element is not None else ""
        print(f"  {source.output_name:40s} <- {source.column}{suffix}")

    X_train, y_train, w_train_phys, p_train = common.load_split(
        args.dataset_root, manifest, "train", sources
    )
    X_val, y_val, w_val, p_val = common.load_split(
        args.dataset_root, manifest, "validation", sources
    )
    X_train, y_train, w_train_phys, p_train = common.cap_by_class(
        X_train,
        y_train,
        w_train_phys,
        p_train,
        args.max_training_events_per_class,
        args.random_state,
    )
    X_val, y_val, w_val, p_val = common.cap_by_class(
        X_val,
        y_val,
        w_val,
        p_val,
        args.max_validation_events_per_class,
        args.random_state + 1,
    )
    training_weights = common.balanced_training_weights(y_train, w_train_phys)

    print("\nFitting median imputer and weighted standardization...")
    imputer, scaler, X_train_scaled = fit_preprocessing(X_train, training_weights)
    X_val_scaled = transform_features(X_val, imputer, scaler)

    model = MLPClassifier(
        hidden_layer_sizes=tuple(args.hidden_layer_sizes),
        activation=args.activation,
        solver="adam",
        alpha=args.alpha,
        batch_size=args.batch_size,
        learning_rate_init=args.initial_learning_rate,
        max_iter=args.max_epochs,
        shuffle=True,
        early_stopping=True,
        validation_fraction=args.validation_fraction,
        n_iter_no_change=args.early_stopping_patience,
        tol=args.tol,
        random_state=args.random_state,
        verbose=True,
    )

    start = time.perf_counter()
    fit_supports_weights = "sample_weight" in inspect.signature(model.fit).parameters
    if fit_supports_weights:
        model.fit(X_train_scaled, y_train, sample_weight=training_weights)
        fit_mode = "balanced_sample_weights"
    else:
        print(
            "WARNING: this scikit-learn version does not support sample_weight "
            "for MLPClassifier; using an equal-class weighted resample."
        )
        X_fit, y_fit = weighted_resample_for_legacy_sklearn(
            X_train_scaled, y_train, training_weights, args.random_state
        )
        model.fit(X_fit, y_fit)
        fit_mode = "equal_class_weighted_resample"
    fit_seconds = time.perf_counter() - start
    scores = model.predict_proba(X_val_scaled)[:, 1]

    auc = roc_auc_score(y_val, scores, sample_weight=w_val)
    ap = average_precision_score(y_val, scores, sample_weight=w_val)
    systematics = sorted(set(args.background_systematics))
    scan = common.threshold_scan(y_val, scores, w_val, systematics, args.thresholds)
    z_column = f"asimov_z_bkg_syst_{args.optimize_background_systematic:g}"
    eligible = scan[
        (scan["background_neff"] >= args.min_background_neff)
        & np.isfinite(scan[z_column])
    ]
    if eligible.empty:
        raise RuntimeError(
            f"No threshold has background Neff >= {args.min_background_neff}. "
            "Increase validation statistics or lower --min-background-neff "
            "for diagnostics only."
        )
    best = eligible.loc[eligible[z_column].idxmax()]
    threshold = float(best["threshold"])

    importance_frame = pd.DataFrame(
        columns=["feature", "importance_mean", "importance_std"]
    )
    if args.importance_events_per_class > 0:
        X_imp, y_imp, w_imp, _ = common.cap_by_class(
            X_val,
            y_val,
            w_val,
            p_val,
            args.importance_events_per_class,
            args.random_state + 2,
        )
        X_imp_scaled = transform_features(X_imp, imputer, scaler)
        imp_weights = common.balanced_training_weights(y_imp, w_imp)
        importance_kwargs: dict[str, Any] = {
            "scoring": "roc_auc",
            "n_repeats": 5,
            "random_state": args.random_state,
            "n_jobs": -1,
        }
        try:
            importance = permutation_importance(
                model,
                X_imp_scaled,
                y_imp,
                sample_weight=imp_weights,
                **importance_kwargs,
            )
        except TypeError:
            importance = permutation_importance(
                model, X_imp_scaled, y_imp, **importance_kwargs
            )
        importance_frame = pd.DataFrame(
            {
                "feature": output_names,
                "importance_mean": importance.importances_mean,
                "importance_std": importance.importances_std,
            }
        ).sort_values("importance_mean", ascending=False)

    metrics = {
        "model": "event_mlp_22_variables",
        "feature_count": len(output_names),
        "features": output_names,
        "hidden_layer_sizes": list(args.hidden_layer_sizes),
        "activation": args.activation,
        "alpha": args.alpha,
        "batch_size": args.batch_size,
        "initial_learning_rate": args.initial_learning_rate,
        "epochs_completed": int(model.n_iter_),
        "fit_mode": fit_mode,
        "fit_seconds": fit_seconds,
        "n_train": len(X_train),
        "n_validation": len(X_val),
        "weighted_roc_auc": auc,
        "weighted_average_precision": ap,
        "optimization_background_systematic": args.optimize_background_systematic,
        "min_background_neff": args.min_background_neff,
        "best_cut": best.to_dict(),
        "background_systematics": systematics,
    }
    bundle = {
        "model": model,
        "imputer": imputer,
        "scaler": scaler,
        "feature_names": output_names,
        "event_features": event_feature_names,
        "base_jet_features": jet_feature_names,
        "feature_sources": [source.__dict__ for source in sources],
        "validation_threshold": threshold,
        "metrics": common.json_safe(metrics),
    }
    joblib.dump(bundle, args.output_dir / "event_nn_22_variables.joblib")
    scan.to_csv(args.output_dir / "significance_scan.csv", index=False)
    common.operating_points(y_val, scores, w_val).to_csv(
        args.output_dir / "matched_signal_efficiency_points.csv", index=False
    )
    composition_table(y_val, scores, w_val, p_val, threshold).to_csv(
        args.output_dir / "best_cut_process_composition.csv", index=False
    )
    importance_frame.to_csv(
        args.output_dir / "permutation_importance.csv", index=False
    )
    pd.DataFrame(
        {"epoch": np.arange(1, len(model.loss_curve_) + 1), "training_loss": model.loss_curve_}
    ).to_csv(args.output_dir / "training_loss.csv", index=False)
    (args.output_dir / "metrics.json").write_text(
        json.dumps(common.json_safe(metrics), indent=2) + "\n"
    )

    print("\nValidation result")
    print(f"  Weighted ROC AUC:             {auc:.6f}")
    print(f"  Weighted average precision:   {ap:.6g}")
    print(f"  Epochs completed:             {model.n_iter_}")
    print(f"  Best threshold:               {threshold:.6f}")
    print(f"  Signal yield:                 {best['signal_yield']:.6g}")
    print(f"  Background yield:             {best['background_yield']:.6g}")
    print(f"  Signal efficiency:            {best['signal_efficiency']:.6g}")
    print(f"  Background efficiency:        {best['background_efficiency']:.6e}")
    print(f"  S/B:                          {best['s_over_b']:.6g}")
    for frac in systematics:
        print(
            f"  Asimov Z ({100 * frac:g}% bkg syst):     "
            f"{best[f'asimov_z_bkg_syst_{frac:g}']:.6g}"
        )
    print(f"  Background effective N:       {best['background_neff']:.3f}")
    print(f"\nSaved results to {args.output_dir}")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise